# =====================================================================
# Elite Music API — Production Environment Configuration
# =====================================================================

# Environment & Server
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
WORKERS_COUNT=4

# Master / Owner Admin Key (Bypasses all rate limits & quotas)
MASTER_ADMIN_KEY=master_live_sec_999a8b7c6d5e4f3a2b1c0d9e8f7a6b5c

# Database (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://elitemusic:secure_pg_password_2026@postgres:5432/elitemusic_db
# For local testing without postgres, can fallback to: sqlite+aiosqlite:///./elitemusic.db

# Redis 7 Cluster / Standalone (State, Locks, Rate Limiting)
REDIS_URL=redis://redis:6379/0

# Private Telegram Admin Logging Channel (Batched Async Dispatcher)
TELEGRAM_LOGGER_ENABLED=true
TELEGRAM_LOGGER_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_LOGGER_CHANNEL_ID=-1001928374650
TELEGRAM_LOG_FLUSH_INTERVAL_SECONDS=2.0
TELEGRAM_LOG_BATCH_SIZE=15

# Telegram MTProto App Credentials (Used by Worker Fleet Assistants)
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789

# Assistant Userbot Session Pool (Comma separated Pyrogram Session Strings)
ASSISTANT_SESSION_STRINGS=session_string_1,session_string_2

# AWS IPv6 Subnet for Zero-Cost Dynamic Anti-Blocking Egress
AWS_IPV6_SUBNET=
# e.g., 2600:1f18:xxxx:xxxx::/64 (Leave blank if not on AWS IPv6-enabled EC2)

# Resource Hard Ceilings (Anti-DDoS)
MAX_AUDIO_DURATION_FREE_SEC=1200     # 20 minutes
MAX_AUDIO_DURATION_PRO_SEC=3600      # 60 minutes
MAX_VIDEO_DURATION_PRO_SEC=600       # 10 minutes
MAX_VIDEO_DURATION_ENT_SEC=1800      # 30 minutes
MAX_STREAM_RAM_AUDIO_MB=64
MAX_STREAM_RAM_VIDEO_MB=256
